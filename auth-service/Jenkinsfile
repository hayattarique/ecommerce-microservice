pipeline {
    agent any

    options {
        disableConcurrentBuilds()
        timestamps()
    }

    environment {
        MODULE = 'auth-service'
    }

    stages {

        stage('Build utility-service') {
            steps {
                dir('utility-service') {
                    sh 'mvn clean install'
                }
            }
        }

        stage('Test') {
            steps {
                dir("${MODULE}") {
                    sh 'mvn clean test'
                }
            }
        }
    }
}