pipeline {
    agent any

    options {
        disableConcurrentBuilds()
        timestamps()
        buildDiscarder(logRotator(numToKeepStr: '15'))
    }

    // Makes this job respond to the GitHub push webhook. Without this the
    // webhook is delivered, Jenkins finds no job subscribed to it, and nothing
    // happens. Equivalent to ticking "GitHub hook trigger for GITScm polling"
    // in the job config. NOTE: run this job manually once after adding it --
    // Jenkins only registers the trigger after it has read the Jenkinsfile.
    triggers {
        githubPush()
    }

    environment {
        MODULE   = 'discovery-server'
        APP_PORT = '8761'
        PROFILE  = 'dev'
    }

    stages {

        // discovery-server's <parent> has no <relativePath>, so Maven looks for
        // ecommerce-parent in the local repo -- install that POM first.
        // It does not depend on utility-service.
        stage('Install parent POM') {
            steps {
                dir('ecommerce-parent') {
                    sh 'mvn -B -N clean install'
                }
            }
        }

        stage('Test') {
            steps {
                dir("${MODULE}") {
                    sh 'mvn -B clean test'
                }
            }
        }

        stage('Package') {
            steps {
                dir("${MODULE}") {
                    sh 'mvn -B package -DskipTests'
                }
            }
        }

        // Kills the jar left over from the previous build.
        // '|| true' keeps the build green on the very first run,
        // when there is nothing to kill.
        //
        // NOTE: restarting this service empties the service registry. The other
        // services stay up and re-register on their next heartbeat (~30s), but
        // service-to-service lookups can fail during that window.
        stage('Stop old instance') {
            steps {
                // Polite shutdown (SIGTERM) so the registry closes cleanly.
                sh 'pkill -f "$MODULE/target" || true'
                sh 'sleep 15'
                // Force anything that ignored it -- otherwise the port stays
                // occupied and the new instance cannot bind.
                sh 'pkill -9 -f "$MODULE/target" || true'
                sh 'sleep 3'
            }
        }

        stage('Deploy jar') {
            steps {
                sh '''
                    JENKINS_NODE_COOKIE=dontKillMe nohup java -jar $WORKSPACE/$MODULE/target/*.jar --spring.profiles.active=$PROFILE --server.port=$APP_PORT > /tmp/$MODULE.log 2>&1 &
                    sleep 5
                    tail -n 20 /tmp/$MODULE.log
                '''
            }
        }

        // curl retries for 60s (12 x 5s) while the port is still closed and
        // while health returns 503 (DOWN), so this passes as soon as the service
        // reports UP and fails the build with the app log otherwise.
        stage('Health check') {
            steps {
                sh 'curl -sf --retry 12 --retry-delay 5 --retry-connrefused http://localhost:$APP_PORT/actuator/health || { tail -n 100 /tmp/$MODULE.log; exit 1; }'
                echo 'HEALTH CHECKED PASSED!'
            }
        }
    }

    post {
        success {
            echo "${MODULE} deployed and healthy on port ${APP_PORT} (profile: ${PROFILE}) -- http://localhost:${APP_PORT}/actuator/health"
        }
    }
}
