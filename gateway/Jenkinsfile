pipeline {
    agent any

    options {
        disableConcurrentBuilds()
        timestamps()
        buildDiscarder(logRotator(numToKeepStr: '15'))
    }

    // Makes this job respond to the GitHub push webhook. Without this the
    // webhook is delivered, Jenkins finds no job subscribed to it, and nothing
    // happens. Equivalent to ticking "GitHub hook trigger for GITScm polling"
    // in the job config. NOTE: run this job manually once after adding it --
    // Jenkins only registers the trigger after it has read the Jenkinsfile.
    triggers {
        githubPush()
    }

    environment {
        MODULE   = 'gateway'
        APP_PORT = '9999'
        PROFILE  = 'dev'
    }

    stages {

        // Must run FIRST. utility-service builds without this (its <parent> has
        // a <relativePath> pointing at the file on disk), but gateway then
        // resolves utility-service as a dependency *from the repository*, and
        // reading that POM needs ecommerce-parent from the repository too --
        // where relativePath does not apply. -N = this POM only, no modules.
        stage('Install parent POM') {
            steps {
                dir('ecommerce-parent') {
                    sh 'mvn -B -N clean install'
                }
            }
        }

        stage('Build utility-service') {
            steps {
                dir('utility-service') {
                    sh 'mvn -B clean install -DskipTests'
                }
            }
        }

        stage('Test') {
            steps {
                dir("${MODULE}") {
                    sh 'mvn -B clean test'
                }
            }
        }

        stage('Package') {
            steps {
                dir("${MODULE}") {
                    sh 'mvn -B package -DskipTests'
                }
            }
        }

        // Kills the jar left over from the previous build.
        // '|| true' keeps the build green on the very first run,
        // when there is nothing to kill.
        stage('Stop old instance') {
            steps {
                // Polite shutdown first, so Spring Boot deregisters from Eureka
                // and closes the DB pool cleanly.
                sh 'pkill -f "$MODULE/target" || true'
                sh 'sleep 15'
                // Force anything that ignored it -- otherwise the port stays
                // occupied and the new instance cannot bind.
                sh 'pkill -9 -f "$MODULE/target" || true'
                sh 'sleep 3'
            }
        }

        stage('Deploy jar') {
            steps {
                sh '''
                    JENKINS_NODE_COOKIE=dontKillMe nohup java -jar $WORKSPACE/$MODULE/target/*.jar --spring.profiles.active=$PROFILE --server.port=$APP_PORT > /tmp/$MODULE.log 2>&1 &
                    sleep 30
                    tail -n 40 /tmp/$MODULE.log
                '''
                // Fails the build if the JVM died during startup, instead of
                // reporting a false success.
                sh 'pgrep -f "$MODULE/target"'
            }
        }
    }

    post {
        success {
            echo "${MODULE} deployed on port ${APP_PORT} (profile: ${PROFILE})"
        }
    }
}
